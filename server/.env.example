# Bind address and port (0.0.0.0 = all interfaces)
HOST=0.0.0.0
PORT=3001
CLIENT_PORT=5173

# Deepgram real-time transcription API key
# Get yours at https://console.deepgram.com/
# Leave blank to use local Parakeet MLX transcription.
DEEPGRAM_API_KEY=

# Local Parakeet MLX transcription model used when DEEPGRAM_API_KEY is empty.
# Requires Apple Silicon.
PARAKEET_MODEL=mlx-community/parakeet-tdt-0.6b-v2

# OpenAI API key
# Get yours at https://platform.openai.com/
# Leave blank to enable mock/demo mode
OPENAI_API_KEY=

# Default model. The UI can also select GPT-5.6 Terra, Sol, Luna, GPT-4o mini,
# Claude Haiku 5.5, Claude Sonnet 5.5, or Grok 4.7.
OPENAI_MODEL=gpt-5.6-terra

# Anthropic API key, used when Claude Haiku 5.5 or Claude Sonnet 5.5 is selected.
# Get yours at https://platform.claude.com/
ANTHROPIC_API_KEY=

# xAI API key, used when Grok 4.7 is selected.
# Get yours at https://console.x.ai/
XAI_API_KEY=

# Pyannote diarization sidecar
# URL of the local Python FastAPI service (see server/diarization/README.md).
# Leave blank to disable diarization — transcripts will show no speaker labels.
DIARIZATION_URL=http://127.0.0.1:8765
DIARIZATION_HOST=0.0.0.0
DIARIZATION_PORT=8765

# Hugging Face token used by the diarization sidecar
# Generate at https://hf.co/settings/tokens and accept the model terms at
# https://hf.co/pyannote/speaker-diarization-3.1 .
# Not read by the Node server itself — only re-exported by start.sh into the
# Python sidecar's environment.
HF_TOKEN=

# How often (ms) to re-run pyannote on the rolling audio buffer
DIARIZATION_INTERVAL_MS=10000

# How many trailing seconds of session audio each periodic diarization pass
# reprocesses, instead of the whole (growing) session. Bounds each pass's
# compute independent of call length; the final end-of-session pass still
# uses the full session audio. Floored at 20s.
DIARIZATION_WINDOW_SECONDS=120

# Not read by the Node server — only re-exported by start.sh into the Python
# sidecar's environment. Cosine-similarity threshold (0-1) for matching a
# detected speaker cluster against a named /enroll profile or a known
# in-session speaker embedding.
DIAR_MATCH_THRESHOLD=0.6
